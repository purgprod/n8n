      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "https://evolution-api-evolution-api.rqkx8g.easypanel.host/instance/connectionState/purg-whatsapp",
        "sendHeaders": true,
