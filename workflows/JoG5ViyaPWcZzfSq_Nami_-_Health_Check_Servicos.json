      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "https://jinx.purg.com.br/api/webhook/nami/pendentes",
        "options": {
