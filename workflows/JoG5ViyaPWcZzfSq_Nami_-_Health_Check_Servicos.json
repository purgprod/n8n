    {
      "id": "analisar",
      "name": "Analisar Resultados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const evoData = $('Verificar Evolution API').first().json;\nconst backData = $('Verificar Backend').first().json;\nconst evoStatus = evoData.instance?.state || evoData.state || 'unknown';\nconst evoOk = evoStatus === 'open';\nconst backOk = !backData.error && backData.$response?.status < 500;\n\n// Throttle: only alert once per 30 min per issue type\nconst sd = $getWorkflowStaticData('global');\nconst now = Date.now();\nconst throttleMs = 30 * 60 * 1000;\n\nconst issues = [];\nif (!evoOk) {\n  const lastEvo = sd.lastEvoAlert || 0;\n  if (now - lastEvo > throttleMs) {\n    issues.push('❌ *WhatsApp desconectado* — status: ' + evoStatus);\n    sd.lastEvoAlert = now;\n  }\n}\nif (!backOk) {\n  const lastBack = sd.lastBackAlert || 0;\n  if (now - lastBack > throttleMs) {\n    issues.push('❌ *Backend offline* — status: ' + (backData.$response?.status || 'timeout'));\n    sd.lastBackAlert = now;\n  }\n}\n\nif (issues.length > 0) {\n  const msg = '⚠️ *Health Check — Problema Detectado*\\n\\n' + issues.join('\\n') + '\\n\\nVerifique em: https://n8n-n8n.rqkx8g.easypanel.host';\n  return [{ json: { shouldAlert: true, text: msg } }];\n}\nreturn [{ json: { shouldAlert: false } }];"
      }
    },
    {
      "id": "if-alert",
      "name": "Deve Alertar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
