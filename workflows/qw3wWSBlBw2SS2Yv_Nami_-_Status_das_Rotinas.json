    {
      "id": "montar-relatorio",
      "name": "Montar Relatorio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "jsCode": "const now = new Date();\nconst N13H = 13 * 60 * 60 * 1000;\nconst N10M = 10 * 60 * 1000;\nconst N2H  =  2 * 60 * 60 * 1000;\n\n// JINX: leitura dinâmica via endpoint\nconst jinxData   = $('Buscar Rotinas Jinx').first().json;\nconst jinxRotinas = jinxData.rotinas || [];\n\n// N8N: check via API de execuções\nfunction checkN8n(nodeName, maxAgeMs, label) {\n  const execs = ($( nodeName ).first().json.data || []);\n  if (!execs.length) return { ok: false, label, detail: 'nunca executou' };\n  const e = execs[0];\n  const age = now - new Date(e.startedAt);\n  const tooOld = maxAgeMs ? age > maxAgeMs : false;\n  const ok = e.status === 'success' && !tooOld;\n  const mins = Math.floor(age / 60000);\n  const hrs  = Math.floor(age / 3600000);\n  const days = Math.floor(age / 86400000);\n  let when = mins < 60 ? `há ${mins} min` : hrs < 24 ? `há ${hrs}h` : `há ${days}d`;\n  if (tooOld) when += ' — inativo';\n  return { ok, label, detail: when };\n}\n\nconst n8nRotinas = [\n  checkN8n('Buscar Relatorio Gerencial', N13H, 'Relatório Gerencial'),\n  checkN8n('Buscar Health Check',        N10M, 'Health Check'),\n  checkN8n('Buscar Limpeza Sessoes',     N2H,  'Limpeza de Sessões'),\n  checkN8n('Buscar Aviso COPOM',         null, 'Aviso COPOM'),\n];\n\n// Contagens\nconst okN8n   = n8nRotinas.filter(r => r.ok).length;\nconst failN8n = n8nRotinas.filter(r => !r.ok);\nconst okJinx   = jinxRotinas.filter(r => r.ok).length;\nconst failJinx = jinxRotinas.filter(r => !r.ok);\nconst total    = n8nRotinas.length + jinxRotinas.length;\nconst totalOk  = okN8n + okJinx;\nconst nFail    = total - totalOk;\nconst allOk    = nFail === 0;\n\nconst dateStr = now.toLocaleDateString('pt-BR',  { timeZone: 'America/Sao_Paulo' });\nconst timeStr = now.toLocaleTimeString('pt-BR',  { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\n\nlet msg = `📊 *Status das Rotinas — ${dateStr} ${timeStr}*\\n`;\nmsg += allOk\n  ? `🟢 Todas as ${total} rotinas OK\\n`\n  : `🔴 *${nFail} falha${nFail > 1 ? 's' : ''} em ${total} rotinas*\\n`;\n\n// Seção N8N\nmsg += `\\n*N8N* (${okN8n}/${n8nRotinas.length})\\n`;\nfor (const r of n8nRotinas) {\n  msg += `${r.ok ? '✅' : '❌'} ${r.label} — ${r.detail}\\n`;\n}\n\n// Seção JINX\nmsg += `\\n*JINX* (${okJinx}/${jinxRotinas.length})\\n`;\nif (failJinx.length === 0) {\n  msg += `✅ Todas as ${jinxRotinas.length} rodaram com sucesso hoje\\n`;\n} else {\n  for (const r of failJinx) {\n    msg += `❌ ${r.descricao || r.nome} — não rodou hoje ou falhou\\n`;\n  }\n  if (okJinx > 0) msg += `✅ ${okJinx} outras rodaram com sucesso\\n`;\n}\n\nreturn [{ json: { text: msg.trim() } }];"
      }
    },
